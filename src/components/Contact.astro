---
const email = "code.braydev@gmail.com";

const channels = [
  {
    icon: "fas fa-envelope",
    title: "Email",
    value: email,
    href: `mailto:${email}`,
    cta: "Escribirme",
    accent: "from-blue-500 to-cyan-400",
  },
  {
    icon: "fas fa-map-pin",
    title: "Ubicación",
    value: "Montería, Córdoba · Colombia",
    href: "https://www.google.com/maps/search/Montería,+Córdoba,+Colombia",
    cta: "GMT-5",
    accent: "from-purple-500 to-fuchsia-400",
  },
  {
    icon: "fas fa-coffee",
    title: "Apoyo",
    value: "Ko-fi · Invítame un café",
    href: "https://ko-fi.com/braydev",
    cta: "Apoyar",
    accent: "from-yellow-500 to-orange-400",
  },
];

const socials = [
  {
    icon: "fab fa-github",
    label: "GitHub",
    value: "@code-braydev",
    href: "https://github.com/code-braydev",
  },
  {
    icon: "fab fa-linkedin-in",
    label: "LinkedIn",
    value: "in/braydev",
    href: "https://www.linkedin.com/in/braydev/",
  },
  {
    icon: "fas fa-rss",
    label: "Blog",
    value: "braydev.xyz",
    href: "https://braydev.xyz",
  },
];
---

<section
  id="contacto"
  class="py-24 border-t border-slate-200 dark:border-slate-900"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="reveal text-center mb-14">
      <span class="text-blue-600 dark:text-blue-400 font-mono text-sm"
        >// contacto</span
      >
      <h2
        class="text-3xl sm:text-4xl font-bold mt-2 flex items-center justify-center gap-4"
      >
        <i class="fas fa-paper-plane text-blue-500"></i> Hablemos de tu proyecto
      </h2>
      <p class="text-slate-600 dark:text-slate-400 mt-3 max-w-2xl mx-auto">
        ¿Tienes una idea, un reto técnico o una oportunidad de colaboración? Mi
        bandeja de entrada siempre está abierta.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
      {
        channels.map((c) => (
          <a
            href={c.href}
            target={c.href.startsWith("mailto") ? undefined : "_blank"}
            rel="noopener noreferrer"
            class="reveal group rounded-3xl p-8 bg-white/70 dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800 backdrop-blur transition-all duration-300 hover:-translate-y-1.5 hover:border-blue-300/70 dark:hover:border-blue-500/40 text-center flex flex-col items-center"
          >
            <div class="relative mb-5">
              <div
                class={`absolute inset-0 rounded-2xl bg-linear-to-br ${c.accent} opacity-25 blur-lg`}
                aria-hidden="true"
              />
              <i
                class={`${c.icon} relative w-14 h-14 flex items-center justify-center rounded-2xl bg-linear-to-br ${c.accent} text-white text-xl shadow-lg group-hover:scale-110 transition-transform`}
              />
            </div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">
              {c.title}
            </h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1 break-all">
              {c.value}
            </p>
            <span class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-blue-600 dark:text-blue-400">
              {c.cta}{" "}
              <i class="fas fa-arrow-right text-xs group-hover:translate-x-1 transition-transform" />
            </span>
          </a>
        ))
      }
    </div>

    <div
      class="reveal rounded-3xl p-8 bg-slate-100/80 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800"
    >
      <h3
        class="text-lg font-bold text-slate-900 dark:text-white mb-6 text-center"
      >
        También puedes encontrarme en
      </h3>
      <div class="flex flex-wrap justify-center gap-4">
        {
          socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-3 px-5 py-3 rounded-2xl bg-white dark:bg-white/5 border border-slate-200 dark:border-slate-700 hover:border-blue-400/60 dark:hover:border-blue-500/50 hover:-translate-y-0.5 transition-all"
            >
              <i class={`${s.icon} text-blue-500 text-lg`} />
              <span class="text-left">
                <span class="block text-xs text-slate-500 dark:text-slate-400">
                  {s.label}
                </span>
                <span class="block text-sm font-bold text-slate-800 dark:text-white">
                  {s.value}
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
