---
const slogan = "Si el código se detiene, mi investigación continúa.";
---

<section
  class="min-h-[80vh] flex flex-col-reverse md:flex-row items-center justify-between gap-12 py-20"
>
  <div class="flex-1 space-y-6 text-center md:text-left">
    <span
      class="inline-block py-1 px-3 rounded-full bg-blue-900/30 border border-blue-500/30 text-blue-400 text-sm font-medium mb-2"
    >
      🚀 Disponible para soluciones eficientes
    </span>

    <h1 class="text-5xl md:text-7xl font-bold leading-tight tracking-tight">
      Hola, soy <br />
      <span
        class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-400"
      >
        BrayDev
      </span>
      <br />
      <span class="text-2xl md:text-3xl text-slate-400 font-normal italic">
        {slogan}
      </span>
    </h1>

    <p
      class="text-slate-400 text-lg md:text-xl max-w-3xl mx-auto md:mx-0 leading-relaxed"
    >
      Desarrollador Full Stack & <strong class="text-white"
        >Docente en formación</strong
      >. Especializado en arquitecturas modernas y en investigar la herramienta
      perfecta para cada reto, desde la web hasta aplicaciones de escritorio.
    </p>

    <div
      class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start pt-6 items-center"
    >
      <a
        href="#proyectos"
        class="w-full sm:w-auto px-8 py-3.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-2xl transition-all hover:scale-105 flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(37,99,235,0.2)]"
      >
        Ver Portafolio <i class="fas fa-briefcase"></i>
      </a>
      <a
        href="https://ko-fi.com/braydev"
        target="_blank"
        class="w-full sm:w-auto px-8 py-3.5 bg-yellow-400 hover:bg-yellow-500 text-black font-bold rounded-2xl transition-all hover:scale-105 flex items-center justify-center gap-2"
      >
        <i class="fas fa-coffee"></i> Apoyar
      </a>
    </div>
  </div>

  <div class="flex-1 flex justify-center md:justify-end relative">
    <div class="absolute inset-0 bg-purple-500/10 blur-[100px] rounded-full">
    </div>
    <img
      src="/me.jpg"
      alt="BrayDev"
      class="relative w-72 h-72 md:w-96 md:h-96 object-cover rounded-[2rem] rotate-2 border-4 border-slate-800 shadow-2xl z-10 hover:rotate-0 transition-all duration-500"
    />
  </div>
</section>
