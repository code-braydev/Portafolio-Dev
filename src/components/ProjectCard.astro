---
interface Props {
  title: string;
  description: string;
  tags: string[];
  link: string;
  isLab?: boolean;
  icon?: string;
}

const { title, description, tags, link, isLab = false, icon } = Astro.props;
---

<a
  href={link}
  target="_blank"
  rel="noopener noreferrer"
  class={`group relative flex flex-col p-7 rounded-3xl bg-white/70 dark:bg-slate-900/40 border backdrop-blur transition-all duration-300 hover:-translate-y-2 ${
    isLab
      ? "border-slate-200 dark:border-slate-800 hover:border-blue-300/70 dark:hover:border-blue-500/40"
      : "border-slate-200 dark:border-blue-500/20 hover:border-blue-400/60 dark:hover:border-blue-500/50 hover:shadow-[0_24px_70px_-20px_rgba(59,130,246,0.35)]"
  } hover:shadow-[0_24px_70px_-20px_rgba(59,130,246,0.25)]`}
>
  <div
    class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-blue-500/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"
    aria-hidden="true"
  >
  </div>

  <div class="flex justify-between items-start mb-5">
    <div class="flex items-center gap-3">
      <div
        class={`w-11 h-11 flex items-center justify-center rounded-xl text-lg bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-slate-700/70 group-hover:scale-110 transition-transform ${
          isLab ? "text-slate-500 dark:text-slate-400" : "text-blue-500"
        }`}
      >
        {
          icon ? (
            <span>{icon}</span>
          ) : isLab ? (
            <i class="fas fa-flask" />
          ) : (
            <i class="fas fa-rocket" />
          )
        }
      </div>
      <div>
        {
          isLab && (
            <span class="text-[10px] font-mono text-slate-600 dark:text-slate-300 uppercase tracking-widest block">
              Fundamentos / Code
            </span>
          )
        }
        <h3
          class={`text-xl font-bold leading-tight transition-colors ${
            isLab
              ? "text-slate-800 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400"
              : "text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400"
          }`}
        >
          {title}
        </h3>
      </div>
    </div>

    {
      isLab ? (
        <i class="fab fa-github text-xl text-slate-600 dark:text-slate-400 group-hover:text-slate-700 dark:group-hover:text-white transition" />
      ) : (
        <i class="fas fa-arrow-up-right-from-square text-slate-600 dark:text-slate-400 group-hover:text-blue-500 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
      )
    }
  </div>

  <p class="text-slate-600 dark:text-slate-400 leading-relaxed text-sm flex-1">
    {description}
  </p>

  <div class="flex flex-wrap gap-2 mt-6">
    {
      tags.map((tag) => (
        <span class="px-2.5 py-1 text-[11px] font-bold bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 rounded-lg border border-slate-200 dark:border-slate-700 uppercase tracking-wide">
          {tag}
        </span>
      ))
    }
  </div>
</a>
