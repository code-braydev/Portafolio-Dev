---

---

<section class="py-20 border-t border-slate-900">
  <div class="mb-12">
    <h2 class="text-3xl font-bold mb-2 flex items-center gap-4">
      <i class="fas fa-server text-blue-400"></i> Stack & Infraestructura
    </h2>
    <p class="text-slate-500">
      Herramientas que domino para construir, orquestar y desplegar software a
      medida.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div
      class="p-8 bg-slate-900/40 rounded-3xl border border-yellow-500/20 hover:bg-slate-900/60 transition group"
    >
      <h3 class="text-xl font-bold text-white mb-6 flex items-center gap-3">
        <i
          class="fab fa-linux text-2xl text-yellow-500 group-hover:scale-110 transition-transform"
        ></i> OS & Infra
      </h3>
      <div class="flex flex-wrap gap-2">
        <span
          class="px-3 py-1 bg-yellow-500/10 text-yellow-400 rounded-lg text-sm border border-yellow-500/20"
          >Linux Nativo & WSL</span
        >
        <span class="px-3 py-1 bg-slate-800 text-slate-200 rounded-lg text-sm"
          >SSH Master</span
        >
        <span
          class="px-3 py-1 bg-blue-600/10 text-blue-400 rounded-lg text-sm border border-blue-600/20"
          >Docker / n8n</span
        >
        <span
          class="px-3 py-1 bg-orange-500/10 text-orange-400 rounded-lg text-sm border border-orange-500/20"
          >AWS VPS / Cloud</span
        >
        <span class="px-3 py-1 bg-slate-800 text-white rounded-lg text-sm"
          >Vercel</span
        >
      </div>
    </div>

    <div
      class="p-8 bg-slate-900/40 rounded-3xl border border-purple-500/20 hover:bg-slate-900/60 transition group"
    >
      <h3 class="text-xl font-bold text-white mb-6 flex items-center gap-3">
        <i
          class="fas fa-database text-2xl text-purple-400 group-hover:scale-110 transition-transform"
        ></i> Backend & Data
      </h3>
      <div class="flex flex-wrap gap-2">
        <span
          class="px-3 py-1 bg-yellow-500/10 text-yellow-400 rounded-lg text-sm border border-yellow-500/20"
          >JavaScript</span
        >
        <span
          class="px-3 py-1 bg-blue-600/10 text-blue-400 rounded-lg text-sm border border-blue-600/20"
          >TypeScript</span
        >
        <span
          class="px-3 py-1 bg-green-900/20 text-green-400 rounded-lg text-sm border border-green-900/30"
          >Node.js / Express</span
        >
        <span
          class="px-3 py-1 bg-red-900/20 text-red-400 rounded-lg text-sm border border-red-900/30"
          >NestJS</span
        >
        <span class="px-3 py-1 bg-slate-800 text-slate-300 rounded-lg text-sm"
          >Supabase / Prisma</span
        >
      </div>
    </div>

    <div
      class="p-8 bg-slate-900/40 rounded-3xl border border-cyan-500/20 hover:bg-slate-900/60 transition group"
    >
      <h3 class="text-xl font-bold text-white mb-6 flex items-center gap-3">
        <i
          class="fas fa-layer-group text-2xl text-cyan-400 group-hover:scale-110 transition-transform"
        ></i> Frontend
      </h3>
      <div class="flex flex-wrap gap-2">
        <span
          class="px-3 py-1 bg-cyan-900/20 text-cyan-400 rounded-lg text-sm border border-cyan-900/30"
          >React / Next.js</span
        >
        <span
          class="px-3 py-1 bg-orange-900/20 text-orange-400 rounded-lg text-sm border border-orange-900/30"
          >Astro</span
        >
        <span
          class="px-3 py-1 bg-emerald-900/20 text-emerald-400 rounded-lg text-sm border border-emerald-900/30"
          >Vue / Nuxt</span
        >
        <span class="px-3 py-1 bg-slate-800 text-slate-300 rounded-lg text-sm"
          >Expo / React Native</span
        >
        <span class="px-3 py-1 bg-slate-800 text-slate-300 rounded-lg text-sm"
          >Electron / Vite</span
        >
        <span class="px-3 py-1 bg-slate-800 text-blue-300 rounded-lg text-sm"
          >Tailwind CSS</span
        >
      </div>
    </div>
  </div>
</section>
