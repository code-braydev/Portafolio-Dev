---
const navLinks = [
  { href: "#inicio", label: "Inicio" },
  { href: "#proyectos", label: "Proyectos" },
  { href: "#stack", label: "Stack" },
  { href: "#trayectoria", label: "Trayectoria" },
  { href: "#sobre-mi", label: "Sobre mí" },
  { href: "#contacto", label: "Contacto" },
];
---

<header
  class="fixed top-0 inset-x-0 z-50 border-b border-slate-200/70 dark:border-slate-800/60 bg-white/70 dark:bg-[#05050a]/70 backdrop-blur-xl"
>
  <nav
    class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4"
  >
    <a
      href="#inicio"
      class="flex items-center gap-2.5 group shrink-0"
      aria-label="Ir al inicio"
    >
      <img
        src="/logo.svg"
        alt="Logo de BrayDev"
        class="h-9 w-auto drop-shadow-[0_0_10px_rgba(59,130,246,0.35)] transition-transform group-hover:scale-105"
      />
      <span class="font-bold text-xl tracking-tighter">
        bray<span class="text-blue-500">dev</span><span class="text-purple-500"
          >.</span
        >
      </span>
    </a>

    <div class="hidden md:flex items-center gap-1" id="desktop-nav">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            data-nav={link.href.slice(1)}
            class="px-3 py-2 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/5 transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-1.5">
      <a
        href="https://github.com/code-braydev"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="hidden sm:inline-flex w-10 h-10 items-center justify-center rounded-xl text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/5 transition"
      >
        <i class="fab fa-github text-lg"></i>
      </a>
      <a
        href="https://www.linkedin.com/in/braydev/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="hidden sm:inline-flex w-10 h-10 items-center justify-center rounded-xl text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/5 transition"
      >
        <i class="fab fa-linkedin-in text-lg"></i>
      </a>

      <button
        id="theme-toggle"
        type="button"
        aria-label="Cambiar tema claro/oscuro"
        class="w-10 h-10 inline-flex items-center justify-center rounded-xl text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/5 transition"
      >
        <i class="fas fa-moon dark:hidden"></i>
        <i class="fas fa-sun hidden dark:inline-block"></i>
      </button>

      <button
        id="menu-toggle"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="md:hidden w-10 h-10 inline-flex items-center justify-center rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/5 transition"
      >
        <i class="fas fa-bars"></i>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="md:hidden px-4 pb-4 pt-1 flex flex-col gap-1 border-t border-slate-200/70 dark:border-slate-800/60"
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          data-nav={link.href.slice(1)}
          class="px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/5 transition-colors"
        >
          {link.label}
        </a>
      ))
    }
  </div>
</header>

<script is:inline>
  const root = document.documentElement;
  const toggle = document.getElementById("theme-toggle");
  const menuToggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");

  toggle.addEventListener("click", () => {
    const isDark = root.classList.toggle("dark");
    try {
      localStorage.setItem("braydev-theme", isDark ? "dark" : "light");
    } catch (e) {}
  });

  menuToggle.addEventListener("click", () => {
    const open = mobileMenu.classList.toggle("hidden");
    menuToggle.setAttribute("aria-expanded", String(!open));
    menuToggle.innerHTML = open
      ? '<i class="fas fa-bars"></i>'
      : '<i class="fas fa-xmark"></i>';
  });

  mobileMenu.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu.classList.add("hidden");
      menuToggle.setAttribute("aria-expanded", "false");
      menuToggle.innerHTML = '<i class="fas fa-bars"></i>';
    });
  });

  const navItems = document.querySelectorAll("[data-nav]");
  const sections = [...navItems]
    .map((item) => document.getElementById(item.dataset.nav))
    .filter(Boolean);

  const spy = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            const active = item.dataset.nav === entry.target.id;
            item.classList.toggle("text-blue-500", active);
            item.classList.toggle("dark:text-blue-400", active);
          });
        }
      });
    },
    { rootMargin: "-45% 0px -50% 0px", threshold: 0 },
  );

  sections.forEach((section) => spy.observe(section));
</script>
