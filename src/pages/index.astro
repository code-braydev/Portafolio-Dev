---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Skills from "../components/Skills.astro";
import Footer from "../components/Footer.astro";

const mainProjects = [
  {
    title: "📰 BrayNews Portal",
    description:
      "Portal de noticias dinámico con SSR y optimización SEO. Arquitectura automatizada que pone a prueba el rendimiento en Node 24.",
    tags: ["Astro", "Vercel", "SSR", "Tailwind"],
    link: "https://braydev.xyz",
  },
  {
    title: "📡 Venus Engine",
    description:
      "Orquestador Open Source para automatización RSS y procesamiento de datos. El motor detrás de la curación de contenido dinámico.",
    tags: ["TypeScript", "Node.js", "Open Source"],
    link: "https://venus.braydev.xyz",
  },
];

const labProjects = [
  {
    title: "⚡ TaskApp Full-Stack",
    description: "Práctica de comunicación cliente-servidor y manejo de CORS.",
    tags: ["React", "Express", "Node.js"],
    link: "https://github.com/code-braydev/taskapp",
    isLab: true,
  },
  {
    title: "🛒 Nuxt E-Commerce bstore",
    description: "Simulador de tienda para explorar Server-Side Rendering.",
    tags: ["Nuxt.js", "Vue", "Vuetify"],
    link: "https://github.com/code-braydev/bstore",
    isLab: true,
  },
  {
    title: "🚦 Semáforo Reactivo",
    description:
      "Laboratorio de reactividad pura y manejo avanzado de ciclos de vida.",
    tags: ["Vue", "Reactivity"],
    link: "https://github.com/code-braydev/semaforo",
    isLab: true,
  },
  {
    title: "🎨 Exams Design Platform",
    description:
      "Plataforma de gestión. Práctica de DOM y maquetación sin frameworks.",
    tags: ["Vanilla JS", "DOM", "HTML/CSS"],
    link: "https://github.com/code-braydev/exams-design",
    isLab: true,
  },
  {
    title: "✖️ Tic-Tac-Toe",
    description:
      "El clásico juego desarrollado desde cero para dominar estados complejos.",
    tags: ["React", "Hooks", "State"],
    link: "https://github.com/code-braydev/React/tree/main/projects/01-tic-tac-toe",
    isLab: true,
  },
  {
    title: "🧮 Calculadora Lógica",
    description:
      "Construcción algorítmica y parsing de operaciones matemáticas.",
    tags: ["Vanilla JS", "Algorithms"],
    link: "https://github.com/code-braydev/calculadora",
    isLab: true,
  },
];
---

<Layout title="BrayDev | Full Stack Developer & Technical Educator">
  <Header />
  <main class="max-w-7xl mx-auto px-4">
    <Hero />

    <section id="proyectos" class="py-20">
      <h2 class="text-3xl font-bold mb-12 flex items-center gap-4">
        <i class="fas fa-rocket text-blue-500"></i> Proyectos Destacados
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {mainProjects.map((p) => <ProjectCard {...p} />)}
      </div>
    </section>

    <Skills />

    <section class="py-20 border-t border-slate-900">
      <div class="mb-12">
        <h2 class="text-3xl font-bold mb-2 flex items-center gap-4">
          <i class="fas fa-code text-slate-500"></i> Fundamentos & Repositorios
        </h2>
        <p class="text-slate-500">
          Exploraciones técnicas, aprendizaje de frameworks y código fuente
          directo en GitHub.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {labProjects.map((p) => <ProjectCard {...p} isLab={true} />)}
      </div>
    </section>
    <section id="sobre-mi" class="py-24 border-t border-slate-900">
      <div class="max-w-3xl">
        <h2 class="text-4xl font-bold mb-8">
          Sobre <span class="text-blue-500">mi</span>
        </h2>

        <p class="text-slate-400 text-lg leading-relaxed mb-6">
          Soy <strong class="text-white">Brayan David Avila Orozco</strong>,
          nacido y forjado en <strong class="text-white"
            >Montería, Córdoba - Colombia</strong
          >. Mi historia con el código despertó a los 15 años impulsada por pura
          curiosidad; desde entonces, lo que empezó como un juego se convirtió
          en mi vocación. Di mis primeros pasos formales graduándome como <strong
            class="text-blue-400"
            >Técnico en Programación de Software en el SENA</strong
          >, y desde ahí la consola de comandos se volvió mi segundo hogar.
        </p>

        <p class="text-slate-400 text-lg leading-relaxed mb-6">
          Como estudiante de la <strong class="text-white"
            >Universidad de Córdoba</strong
          >, mi enfoque no es solo construir, sino entender el porqué de cada
          línea. Me apasiona la <strong class="text-blue-400"
            >docencia técnica</strong
          >: creo firmemente que la maestría tecnológica se demuestra cuando
          eres capaz de explicar una arquitectura compleja o un flujo de datos
          de forma sencilla.
        </p>

        <p class="text-slate-400 text-lg leading-relaxed mb-6">
          Mi formación técnica se forjó bajo fuego. Aprendí a optimizar recursos
          en hardware limitado, lo que me llevó a dominar la terminal <strong
            class="text-white">Linux</strong
          > (desde Debian hasta la rigurosa instalación manual de <strong
            class="text-white">Arch</strong
          >). Esa base pura me permite hoy moverme con fluidez en entornos
          híbridos con <strong class="text-blue-400">WSL</strong>, gestionar
          servidores remotos vía <strong class="text-purple-400">SSH</strong>,
          orquestar servicios en <strong class="text-blue-400">Docker</strong> y automatizar
          procesos con IA y scripts en Python sin depender de "cajas negras".
        </p>

        <p class="text-slate-400 text-lg leading-relaxed">
          Desde levantar un backend robusto hasta procesar analítica de datos o
          maquetar una interfaz intuitiva, mi compromiso es encontrar la <strong
            class="text-green-400">mejor solución técnica</strong
          >, no la más rápida de copiar. Mi portafolio refleja esta filosofía:
          proyectos que no solo funcionan, sino que tienen detrás un proceso
          real de investigación. Si el código se detiene, mi investigación
          continúa.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
